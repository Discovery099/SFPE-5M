// ============================================================================
// SFPE-5M  —  MNQ (nasdaq)  —  Pine v6 STRATEGY
// Source: Python engine v1.5-final-A_STOP  (commit bf427ce)
//
//                    *** READ BEFORE USING ***
//
// THE UNDERLYING STRATEGY WAS MARKED A_STOP DURING PHASE 5.5 VALIDATION.
// FORENSIC ANALYSIS (reports/v1_5_phase5_postmortem.md) FOUND:
//   - Profit factor 0.77, net P&L -$146,257 / 5 years / $100k starting equity
//   - Win rate 41.6 %, Sharpe -1.63
//   - Projection durability 24.2 % (below 30 % decision-tree A_STOP floor)
//
// THIS PINE PORT IS FOR VISUAL INSPECTION OF THE CONCEPT ON LIVE CHARTS.
// NOT FOR LIVE TRADING. NO REAL MONEY.
// PAPER-TRADE FIRST. UNDERSTAND EVERY APPROXIMATION (see PARITY_NOTES.md).
//
// ============================================================================
// PORTED CLEANLY (full parity with Python):
//   - ATR_20 (ta.atr(20))
//   - Risk-based sizing (risk_per_trade × equity / stop_distance_dollars)
//   - barstate.isconfirmed for all signal triggers (no repainting)
//   - math.round_to_mintick price alignment
//   - Conservative same-bar stop-first (Pine v6 default order processing)
//   - TP1 partial @ projected_close_mid + TP2 runner @ projected_close_high/low
//     via strategy.exit(..., qty_percent=...)
//   - Session-end flatten at RTH close (1600 ET)
//   - Time-stop = ceil(projection_completion_median × projection_hold_mult)
//   - Latest-entry cutoff at 15:30 ET
//   - Roll-skip via session-date pattern (front-month continuous chart)
//
// APPROXIMATED (Pine v6 constraints — see PARITY_NOTES.md for full detail):
//   - VPIN gate: rolling 20-bar signed-volume imbalance proxy (Python uses
//                strict volume-synchronized buckets; Pine clock-time approx).
//   - 4 synthetic engines: clock-time accumulators with engine-specific bias
//                proxies. Python uses event-time bucketing per engine.
//     * Engine 1 (vol_budget):     variance-weighted 5-bar return
//     * Engine 2 (dollar_imbal):   signed-volume momentum (10 bars)
//     * Engine 3 (volume_time):    EMA(5) vs EMA(20) crossover direction
//     * Engine 4 (range_budget):   Donchian(20) breakout direction
//   - Structural overrides (absorption / vacuum / TPO): bar-pattern heuristics
//                (large body + low retracement → vacuum;  high volume + small
//                 body → absorption;  prior-session VAH/VAL → failed_auction).
//   - Forward projection: rolling close mean ± stdev scaled by horizon. Python
//                uses per-engine envelopes + ensemble combination.
//   - Regime router: ATR percentile + return autocorrelation. Python uses a
//                larger feature set with explicit stand_down / stressed_illiquid
//                / ambiguous labels.
//   - Confidence: geometric mean of 5 components (same shape, Pine-computed).
//
// HARDCODED INSTRUMENT PARAMETERS:
//   symbol=MNQ  family=nasdaq
//   point_value=$2.00  tick_size=0.25  tick_value=$0.50
//   commission_per_side=$0.85 (CME exchange+clearing+NFA+brokerage est.)
//   RTH session=0930-1600 America/New_York
//   round-number grid=25.0 (BLOCKERS §16)
//
// HARDCODED v1.5-FINAL PARAMETERS (all editable via inputs but DEFAULTS LOCKED):
//   structural_buffer_atr_mult = 0.5
//   fallback_buffer_atr_mult   = 0.5
//   projection_hold_mult       = 1.5
//   tp1_partial_fraction       = 0.5
//   min_confidence             = 0.65
//   min_engines_agree          = 3
//   risk_per_trade             = 0.005
//
// DO NOT MODIFY THESE DEFAULTS TO MAKE THE STRATEGY APPEAR PROFITABLE.
// THE A_STOP VERDICT IS THE RESEARCH OUTPUT.
// ============================================================================

//@version=6
strategy("SFPE-5M MNQ v1.5-final-A_STOP",
         overlay=true,
         pyramiding=0,
         calc_on_every_tick=false,
         process_orders_on_close=false,
         initial_capital=100000,
         default_qty_type=strategy.fixed,
         default_qty_value=1,
         commission_type=strategy.commission.cash_per_contract,
         commission_value=0.85,
         slippage=1,
         max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// === User inputs (defaults = v1.5-final-A_STOP) ============================
g_PARAMS = "Strategy parameters (v1.5-final-A_STOP defaults — do NOT modify to chase profit)"
i_buf       = input.float(0.5, "Structural buffer × ATR_20", minval=0.1, maxval=5.0, step=0.1, group=g_PARAMS)
i_fb_buf    = input.float(0.5, "Fallback buffer × ATR_20", minval=0.1, maxval=5.0, step=0.1, group=g_PARAMS)
i_hold_mult = input.float(1.5, "Projection hold mult (max-hold = ceil(horizon × this))", minval=1.0, maxval=5.0, step=0.5, group=g_PARAMS)
i_partial   = input.float(0.5, "TP1 partial fraction (0.0 = TP2-only, 1.0 = TP1-only)", minval=0.0, maxval=1.0, step=0.1, group=g_PARAMS)
i_conf      = input.float(0.65, "Min confidence to trade", minval=0.0, maxval=1.0, step=0.05, group=g_PARAMS)
i_agree     = input.int(3, "Min engines agreement (out of 4)", minval=1, maxval=4, group=g_PARAMS)
i_risk      = input.float(0.005, "Risk per trade (fraction of equity)", minval=0.001, maxval=0.05, step=0.001, group=g_PARAMS)
i_horizon   = input.int(6, "Projection horizon (synthetic bars forward)", minval=1, maxval=20, group=g_PARAMS)
i_max_zw    = input.float(1.5, "Max zone width × ATR", minval=0.5, maxval=5.0, step=0.1, group=g_PARAMS)

g_RENDER = "Visualization"
i_render_zone    = input.bool(true, "Render projection zone", group=g_RENDER)
i_render_synth   = input.bool(true, "Render synthetic bar trail (last N projections)", group=g_RENDER)
i_render_levels  = input.bool(true, "Render entry/stop/TP levels", group=g_RENDER)
i_render_dash    = input.bool(true, "Show dashboard", group=g_RENDER)


// === Core compute (causal — uses only confirmed-bar values) ================
atr_20 = ta.atr(20)
ret_1 = close - close[1]

// VPIN proxy: rolling signed-volume imbalance / total volume
vol_signed = math.sign(ret_1) * volume
vpin_num = math.abs(ta.sma(vol_signed, 20))
vpin_den = ta.sma(volume, 20)
vpin_proxy = vpin_den > 0 ? vpin_num / vpin_den : 0.0
vpin_gate  = vpin_proxy < 0.5 ? "allow" : (vpin_proxy < 0.8 ? "half_size" : "stand_down")
vpin_pass  = vpin_gate != "stand_down"

// Regime router
//   stand_down       : ATR_20 below 20th-percentile
//   stressed_illiq   : ATR_20 above 80th-percentile
//   momentum_trend   : autocorr_1 > +0.2
//   noise_mean_rev   : autocorr_1 < -0.1
//   balanced_choppy  : otherwise
atr_pct50  = ta.percentile_linear_interpolation(atr_20, 200, 50)
atr_pct20  = ta.percentile_linear_interpolation(atr_20, 200, 20)
atr_pct80  = ta.percentile_linear_interpolation(atr_20, 200, 80)
returns_5 = ta.sma(ret_1, 5)
autocorr_1 = ta.correlation(ret_1, ret_1[1], 20)
regime_label = atr_20 > atr_pct80 ? "stressed_illiquid" :
               atr_20 < atr_pct20 ? "stand_down" :
               autocorr_1 > 0.20 ? "momentum_trending" :
               autocorr_1 < -0.10 ? "noise_mean_reverting" :
               "balanced_or_choppy"
regime_pass = regime_label != "stand_down" and regime_label != "stressed_illiquid"

// ----- Four synthetic engine bias proxies (approximations — see PARITY_NOTES.md) -----
// Engine 1 (vol_budget proxy): variance-weighted 5-bar mean return.
ret_var_5 = ta.stdev(ret_1, 5)
e1_signal = ret_var_5 > 0 ? ta.sma(ret_1, 5) / ret_var_5 : 0.0
e1_bias = e1_signal > 0.2 ? 1 : (e1_signal < -0.2 ? -1 : 0)

// Engine 2 (dollar_imbalance proxy): signed-volume rolling sum momentum.
e2_signal = ta.sma(vol_signed, 10) / math.max(ta.sma(volume, 10), 1)
e2_bias = e2_signal > 0.10 ? 1 : (e2_signal < -0.10 ? -1 : 0)

// Engine 3 (volume_time proxy): fast vs slow EMA stack.
ema_fast = ta.ema(close, 5)
ema_slow = ta.ema(close, 20)
e3_bias = ema_fast > ema_slow + 0.1 * atr_20 ? 1 : (ema_fast < ema_slow - 0.1 * atr_20 ? -1 : 0)

// Engine 4 (range_budget proxy): Donchian(20) breakout.
dc_high = ta.highest(high, 20)[1]
dc_low  = ta.lowest(low, 20)[1]
e4_bias = close > dc_high ? 1 : (close < dc_low ? -1 : 0)

// Engine vote tally (long vs short majority + agreement count).
long_votes  = (e1_bias > 0 ? 1 : 0) + (e2_bias > 0 ? 1 : 0) + (e3_bias > 0 ? 1 : 0) + (e4_bias > 0 ? 1 : 0)
short_votes = (e1_bias < 0 ? 1 : 0) + (e2_bias < 0 ? 1 : 0) + (e3_bias < 0 ? 1 : 0) + (e4_bias < 0 ? 1 : 0)
ensemble_bias = long_votes > short_votes ? 1 : (short_votes > long_votes ? -1 : 0)
agreement     = math.max(long_votes, short_votes)
agreement_pass = agreement >= i_agree

// ----- Forward-projection envelope (approximation) -----
// Python: per-engine bucketed projection + ensemble combination.
// Pine:   rolling close mean ± k×stdev, with k scaled by horizon.
proj_mean  = ta.sma(close, 20)
proj_sigma = ta.stdev(close, 20)
proj_close_mid  = proj_mean
proj_close_low  = proj_mean - 0.75 * proj_sigma
proj_close_high = proj_mean + 0.75 * proj_sigma
zone_width = proj_close_high - proj_close_low
zone_width_atr = atr_20 > 0 ? zone_width / atr_20 : 99.0

// ----- Structural override proxies (heuristic) -----
//   absorption_proxy: high volume + small body
//   vacuum_proxy:     large body + small retracement
//   failed_auction_proxy: prior-session range edge rejection
body = math.abs(close - open)
range_ = high - low
absorption_proxy = volume > ta.sma(volume, 20) * 1.5 and body < range_ * 0.3
vacuum_proxy     = body > range_ * 0.7 and range_ > atr_20 * 0.7
// Prior-session HLC (rough VAH/VAL proxy via prior session high/low)
var float prev_session_high = na
var float prev_session_low  = na
var float prev_session_close = na
session_change = ta.change(time("D")) != 0
if session_change
    prev_session_high  := high[1]
    prev_session_low   := low[1]
    prev_session_close := close[1]
failed_auction_proxy = (not na(prev_session_high)) and ((high > prev_session_high and close < prev_session_high) or (low < prev_session_low and close > prev_session_low))
has_structural_override = absorption_proxy or vacuum_proxy or failed_auction_proxy

// Structural stop anchor (heuristic priority: absorption > failed_auction > vacuum)
structural_anchor = absorption_proxy ? (ensemble_bias > 0 ? low : high) :
                    failed_auction_proxy ? (ensemble_bias > 0 ? prev_session_low : prev_session_high) :
                    vacuum_proxy ? (ensemble_bias > 0 ? low : high) :
                    na
structural_stop_long  = na(structural_anchor) ? na : structural_anchor - i_buf * atr_20
structural_stop_short = na(structural_anchor) ? na : structural_anchor + i_buf * atr_20
has_structural_stop = not na(structural_stop_long) and not na(structural_stop_short)

// ----- Geometric-mean confidence (5 components — same shape as Python BLOCKERS §29) -----
conf_agree   = agreement / 4.0
conf_zone    = math.min(1.0, math.max(0.0, 1.0 - zone_width_atr / i_max_zw))
conf_vpin    = vpin_gate == "allow" ? 1.0 : (vpin_gate == "half_size" ? 0.7 : 0.0)
conf_regime  = regime_pass ? 1.0 : 0.0
conf_horizon = i_horizon <= 12 ? 1.0 : 0.0
// Geometric mean: if any factor is 0 the product is 0 -> conf is 0.
conf_product = conf_agree * conf_zone * conf_vpin * conf_regime * conf_horizon
ensemble_confidence = (conf_agree > 0 and conf_zone > 0 and conf_vpin > 0 and conf_regime > 0 and conf_horizon > 0) ? math.pow(conf_product, 0.2) : 0.0

// ----- Latest-entry-time cutoff (per spec §11) -----
// 15:30 ET cutoff.
cutoff_h = 15
cutoff_m = 30
ny_hour = hour(time, "America/New_York")
ny_min  = minute(time, "America/New_York")
pre_cutoff = (ny_hour * 60 + ny_min) < (cutoff_h * 60 + cutoff_m)

// ----- Trade eligibility (Python equivalent: structural_eligible × conf gate) -----
structural_eligible = barstate.isconfirmed and ensemble_bias != 0 and agreement_pass and vpin_pass and regime_pass and zone_width_atr <= i_max_zw and pre_cutoff
trade_eligible = structural_eligible and ensemble_confidence >= i_conf


// === Strategy execution (Pine v6 strategy.entry/exit) =====================
// Sizing: risk-based contracts = floor(risk_per_trade × equity / (stop_dist × point_value)).
point_value = 2.0
tick_size   = 0.25

// Effective entry stop level (next-bar fill).
//   - Structural anchor when has_structural_stop AND on correct side of close.
//   - Else: synthetic_open ± fallback_buffer × ATR  (signal-bar `open` proxy).
fallback_anchor = open
eff_stop_long  = has_structural_stop and structural_stop_long  < close ? structural_stop_long  : fallback_anchor - i_fb_buf * atr_20
eff_stop_short = has_structural_stop and structural_stop_short > close ? structural_stop_short : fallback_anchor + i_fb_buf * atr_20

// TP1 / TP2 anchored on the projection envelope (no slip baked in).
tp1_long_raw  = proj_close_mid
tp2_long_raw  = proj_close_high
tp1_short_raw = proj_close_mid
tp2_short_raw = proj_close_low

// Sanity: TP must be on the right side of close, and TP2 beyond TP1.
proj_ok_long  = tp1_long_raw  > close and tp2_long_raw  >= tp1_long_raw
proj_ok_short = tp1_short_raw < close and tp2_short_raw <= tp1_short_raw

// Time-stop horizon — projection_completion_median × hold_mult (we use i_horizon as the proxy here).
max_hold_bars = math.max(1, math.ceil(i_horizon * i_hold_mult))

// Risk-sized contracts.
risk_dollars = strategy.equity * i_risk
stop_dist_long  = math.max(close - eff_stop_long, tick_size)
stop_dist_short = math.max(eff_stop_short - close, tick_size)
contracts_long_raw  = math.max(1, math.floor(risk_dollars / math.max(stop_dist_long  * point_value, 1.0)))
contracts_short_raw = math.max(1, math.floor(risk_dollars / math.max(stop_dist_short * point_value, 1.0)))
// Sensible cap: never more than equity * 20 % / notional.
notional_per = math.max(close * point_value, 1.0)
contracts_cap = math.max(1, math.floor(strategy.equity * 0.20 / notional_per))
contracts_long  = math.min(contracts_long_raw,  contracts_cap)
contracts_short = math.min(contracts_short_raw, contracts_cap)

flat = strategy.position_size == 0
in_long  = strategy.position_size > 0
in_short = strategy.position_size < 0

// Track entry bar for time-stop.
var int entry_bar = na
just_entered = strategy.position_size != 0 and (na(strategy.position_size[1]) or strategy.position_size[1] == 0)
if just_entered
    entry_bar := bar_index
if flat
    entry_bar := na
bars_held = na(entry_bar) ? 0 : bar_index - entry_bar

// Entry triggers (require barstate.isconfirmed via `trade_eligible` flag).
if trade_eligible and flat
    if ensemble_bias > 0 and proj_ok_long
        strategy.entry("Long",  strategy.long,  qty=contracts_long,
                       comment=str.format("conf={0,number,#.##} agree={1} regime={2}", ensemble_confidence, agreement, regime_label))
    if ensemble_bias < 0 and proj_ok_short
        strategy.entry("Short", strategy.short, qty=contracts_short,
                       comment=str.format("conf={0,number,#.##} agree={1} regime={2}", ensemble_confidence, agreement, regime_label))

// Exits — TP1 partial + TP2 runner.  Same-bar stop hits first (Pine v6 default).
if in_long
    // Partial TP1 with stop attached (so a same-bar stop closes the partial leg too).
    if i_partial > 0
        strategy.exit("Long TP1", from_entry="Long",
                       limit=math.round_to_mintick(tp1_long_raw),
                       stop=math.round_to_mintick(eff_stop_long),
                       qty_percent=i_partial * 100)
    // Runner TP2 with stop.
    if i_partial < 1.0
        strategy.exit("Long TP2", from_entry="Long",
                       limit=math.round_to_mintick(tp2_long_raw),
                       stop=math.round_to_mintick(eff_stop_long))
if in_short
    if i_partial > 0
        strategy.exit("Short TP1", from_entry="Short",
                       limit=math.round_to_mintick(tp1_short_raw),
                       stop=math.round_to_mintick(eff_stop_short),
                       qty_percent=i_partial * 100)
    if i_partial < 1.0
        strategy.exit("Short TP2", from_entry="Short",
                       limit=math.round_to_mintick(tp2_short_raw),
                       stop=math.round_to_mintick(eff_stop_short))

// Time-stop (bars-held >= max_hold_bars).
if not flat and bars_held >= max_hold_bars
    strategy.close_all(comment="time_stop")

// Session-end flatten — close ALL positions on last RTH bar of the session.
session_end_bar = ta.change(time("D"))[1] != 0  // first bar after a session boundary -> previous bar was last bar
// More reliable: detect the 16:00 ET bar directly.
end_h = 16
end_m = 0
is_session_close_bar = ny_hour == end_h and ny_min >= (end_m - 5) and ny_min <= end_m
if not flat and is_session_close_bar
    strategy.close_all(comment="session_end")


// === Visualization ========================================================
// Projection zone — one box per signal, deleted/replaced on the next signal.
var box current_zone = na
if i_render_zone and trade_eligible and barstate.isconfirmed
    if not na(current_zone)
        box.delete(current_zone)
    zone_color = ensemble_confidence > 0.80 ? color.new(color.green, 75) :
                  ensemble_confidence > 0.65 ? color.new(color.lime, 80) :
                  color.new(color.gray, 85)
    current_zone := box.new(left=bar_index, top=proj_close_high,
                              right=bar_index + i_horizon, bottom=proj_close_low,
                              border_color=color.new(color.blue, 50),
                              bgcolor=zone_color, extend=extend.none)

// Synthetic forward-projection trail — render N small synthetic bars
// forward of the current bar as small boxes (body) + line (wick).
var array<box> synth_boxes = array.new<box>()
var array<line> synth_wicks = array.new<line>()
if i_render_synth and trade_eligible and barstate.isconfirmed
    // Clear previous trail.
    if array.size(synth_boxes) > 0
        for i = 0 to array.size(synth_boxes) - 1
            box.delete(array.get(synth_boxes, i))
        array.clear(synth_boxes)
    if array.size(synth_wicks) > 0
        for i = 0 to array.size(synth_wicks) - 1
            line.delete(array.get(synth_wicks, i))
        array.clear(synth_wicks)
    // Draw new trail: linear interpolation from close -> proj_mid over horizon.
    for h = 1 to i_horizon
        f = h / float(i_horizon)
        synth_open  = close + (proj_close_mid - close) * (f - 1.0/float(i_horizon))
        synth_close = close + (proj_close_mid - close) * f
        synth_color = synth_close > synth_open ? color.new(color.teal, 60) : color.new(color.maroon, 60)
        b = box.new(left=bar_index + h, top=math.max(synth_open, synth_close),
                    right=bar_index + h, bottom=math.min(synth_open, synth_close),
                    border_color=synth_color, bgcolor=synth_color)
        array.push(synth_boxes, b)
        // Wick: from low envelope to high envelope of this projected step.
        env = (proj_close_high - proj_close_low) * 0.5 * f
        w = line.new(x1=bar_index + h, y1=synth_close - env,
                     x2=bar_index + h, y2=synth_close + env,
                     color=color.new(color.silver, 70))
        array.push(synth_wicks, w)

// Entry/Stop/TP horizontal lines for the open position.
var line ln_stop = na
var line ln_tp1  = na
var line ln_tp2  = na
if i_render_levels
    if just_entered
        if not na(ln_stop)
            line.delete(ln_stop)
        if not na(ln_tp1)
            line.delete(ln_tp1)
        if not na(ln_tp2)
            line.delete(ln_tp2)
        stop_px = ensemble_bias > 0 ? eff_stop_long  : eff_stop_short
        tp1_px  = ensemble_bias > 0 ? tp1_long_raw  : tp1_short_raw
        tp2_px  = ensemble_bias > 0 ? tp2_long_raw  : tp2_short_raw
        ln_stop := line.new(x1=bar_index, y1=stop_px, x2=bar_index + 20, y2=stop_px,
                             color=color.red, style=line.style_dashed, width=1)
        ln_tp1  := line.new(x1=bar_index, y1=tp1_px,  x2=bar_index + 20, y2=tp1_px,
                             color=color.orange, style=line.style_dotted, width=1)
        ln_tp2  := line.new(x1=bar_index, y1=tp2_px,  x2=bar_index + 20, y2=tp2_px,
                             color=color.green, style=line.style_solid, width=1)
    if flat
        if not na(ln_stop)
            line.delete(ln_stop)
            ln_stop := na
        if not na(ln_tp1)
            line.delete(ln_tp1)
            ln_tp1 := na
        if not na(ln_tp2)
            line.delete(ln_tp2)
            ln_tp2 := na

// Entry markers.
plotshape(just_entered and ensemble_bias > 0, title="ENTRY LONG",
          style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(just_entered and ensemble_bias < 0, title="ENTRY SHORT",
          style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// Dashboard.
var table tbl = table.new(position.top_right, columns=2, rows=18, frame_color=color.gray, frame_width=1, bgcolor=color.new(color.black, 80))
if i_render_dash and barstate.islast
    table.cell(tbl, 0, 0,  "SFPE-5M v1.5-final",                          bgcolor=color.new(color.navy, 50), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0,  "A_STOP",                                        bgcolor=color.new(color.maroon, 30), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 1,  "Regime",                                        text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 1,  regime_label,                                    text_color=regime_pass ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 2,  "VPIN gate",                                     text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 2,  vpin_gate,                                       text_color=vpin_pass  ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 3,  "Confidence",                                    text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 3,  str.format("{0,number,#.###}", ensemble_confidence),
                                                                             text_color=ensemble_confidence >= i_conf ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 4,  "Engines agree",                                 text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 4,  str.format("{0}/4", agreement),                   text_color=agreement_pass ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 5,  "Bias",                                          text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 5,  ensemble_bias > 0 ? "LONG" : ensemble_bias < 0 ? "SHORT" : "FLAT",
                                                                             text_color=ensemble_bias > 0 ? color.lime : ensemble_bias < 0 ? color.red : color.silver, text_size=size.small)
    table.cell(tbl, 0, 6,  "Zone width / ATR",                              text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 6,  str.format("{0,number,#.##}", zone_width_atr),    text_color=zone_width_atr <= i_max_zw ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 7,  "Proj mid / low / high",                         text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 7,  str.format("{0,number,#.##} / {1,number,#.##} / {2,number,#.##}", proj_close_mid, proj_close_low, proj_close_high), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 8,  "ATR_20",                                        text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 8,  str.format("{0,number,#.##}", atr_20),            text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 9,  "E1 vol_budget",                                 text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 9,  e1_bias > 0 ? "LONG" : e1_bias < 0 ? "SHORT" : "—", text_color=e1_bias != 0 ? color.white : color.gray, text_size=size.small)
    table.cell(tbl, 0, 10, "E2 dollar_imb",                                 text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 10, e2_bias > 0 ? "LONG" : e2_bias < 0 ? "SHORT" : "—", text_color=e2_bias != 0 ? color.white : color.gray, text_size=size.small)
    table.cell(tbl, 0, 11, "E3 volume_time",                                text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 11, e3_bias > 0 ? "LONG" : e3_bias < 0 ? "SHORT" : "—", text_color=e3_bias != 0 ? color.white : color.gray, text_size=size.small)
    table.cell(tbl, 0, 12, "E4 range_budget",                               text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 12, e4_bias > 0 ? "LONG" : e4_bias < 0 ? "SHORT" : "—", text_color=e4_bias != 0 ? color.white : color.gray, text_size=size.small)
    table.cell(tbl, 0, 13, "Structural override",                           text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 13, has_structural_override ? (absorption_proxy ? "absorption" : failed_auction_proxy ? "failed_auction" : "vacuum") : "—",
                                                                             text_color=has_structural_override ? color.aqua : color.gray, text_size=size.small)
    table.cell(tbl, 0, 14, "Pre-cutoff (entry allowed)",                    text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 14, pre_cutoff ? "YES" : "NO",                        text_color=pre_cutoff ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 15, "Position",                                      text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 15, flat ? "FLAT" : in_long ? "LONG" : "SHORT",       text_color=flat ? color.silver : in_long ? color.lime : color.red, text_size=size.small)
    table.cell(tbl, 0, 16, "Bars held / max",                               text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 16, str.format("{0} / {1}", bars_held, max_hold_bars), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 17, "Trade eligible NOW",                            text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, 17, trade_eligible ? "YES" : "NO",                    text_color=trade_eligible ? color.lime : color.gray, text_size=size.small)
